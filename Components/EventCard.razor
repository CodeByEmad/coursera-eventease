<div class="event-card">
    <h3>@Event.Name</h3>

    <p>
        <strong>Date:</strong>
        @Event.Date.ToString("dd MMM yyyy")
    </p>

    <p>
        <strong>Location:</strong>
        @Event.Location
    </p>

    <p>@Event.Description</p>

    <p>
        <strong>Available Seats:</strong>
        @Event.AvailableSeats
    </p>

    <div class="form-group">
        <label for="registration-status-@Event.Id">
            Registration Status
        </label>

        <select id="registration-status-@Event.Id"
                class="form-control"
                @bind="RegistrationStatus"
                @bind:after="NotifyRegistrationStatusChanged">
            <option value="false">Not Registered</option>
            <option value="true">Registered</option>
        </select>
    </div>

    @if (RegistrationStatus)
    {
        <p class="alert alert-success">
            You are registered for this event.
        </p>
    }

    <a class="button" href="/events/@Event.Id">
        View Details
    </a>
</div>

@code {
    [Parameter, EditorRequired]
    public Event Event { get; set; } = new();

    [Parameter]
    public bool RegistrationStatus { get; set; }

    [Parameter]
    public EventCallback<bool> RegistrationStatusChanged { get; set; }

    private async Task NotifyRegistrationStatusChanged()
    {
        await RegistrationStatusChanged.InvokeAsync(RegistrationStatus);
    }
}