@page "/events/{Id:int}"
@inject EventService EventService

<PageTitle>Event Details | EventEase</PageTitle>

<div class="container py-5">
    @if (SelectedEvent is null)
    {
        <div class="alert alert-warning">Event not found.</div>
        <a href="/events" class="btn btn-primary">Back to events</a>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <a href="/events" class="text-decoration-none">← Back to events</a>
                <div class="card shadow-sm mt-3">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <h1>@SelectedEvent.Name</h1>
                            <span class="badge @(SelectedEvent.IsFull ? "text-bg-danger" : "text-bg-success")">@(SelectedEvent.IsFull ? "Full" : "Open")</span>
                        </div>
                        <hr />
                        <p><strong>Date:</strong> @SelectedEvent.Date.ToString("dddd, dd MMMM yyyy h:mm tt")</p>
                        <p><strong>Location:</strong> @SelectedEvent.Location</p>
                        <p>@SelectedEvent.Description</p>
                        <p><strong>Available seats:</strong> @SelectedEvent.AvailableSeats</p>
                        @if (!SelectedEvent.IsFull)
                        {
                            <a href="/register/@SelectedEvent.Id" class="btn btn-primary">Register for this event</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Event? SelectedEvent;

    protected override void OnParametersSet()
    {
        SelectedEvent = EventService.GetEvent(Id);
    }
}
