@using EventEase.Models

<div class="card event-card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between gap-2 mb-2">
            <h3 class="h5 mb-0">@Event.Name</h3>
            <span class="badge @(Event.IsFull ? "text-bg-danger" : "text-bg-success")">
                @(Event.IsFull ? "Full" : $"{Event.AvailableSeats} seats")
            </span>
        </div>
        <p class="text-muted mb-1">@Event.Date.ToString("dd MMM yyyy, h:mm tt")</p>
        <p class="text-muted mb-3">@Event.Location</p>
        <p class="flex-grow-1">@Event.Description</p>

        <div class="d-flex gap-2 mt-2">
            <a class="btn btn-outline-primary" href="/events/@Event.Id">Details</a>
            @if (!Event.IsFull)
            {
                <a class="btn btn-primary" href="/register/@Event.Id">Register</a>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Event Event { get; set; } = new();
}
